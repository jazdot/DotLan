<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DotLan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.jazdot.dotlan</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>dotlan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- iOS 14+ Local Network Usage Privacy Permission -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>DotLan discovers local network devices, smart IoT endpoints, and hidden surveillance cameras completely on-device without cloud telemetry.</string>

	<!-- App Store Compliant Bonjour Service Declarations -->
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_airplay._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_ipp._tcp</string>
		<string>_printer._tcp</string>
		<string>_smb._tcp</string>
		<string>_matter._tcp</string>
		<string>_companion-link._tcp</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
